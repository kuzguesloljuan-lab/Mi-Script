					RootPart = rootPart,
					Layer1 = r1,
					Layer2 = r2,
					Audio = coreSound,
					NameLabel = nameLabel,
					NameStroke = nameStroke
				}
			end
			
			joinedPlayer.CharacterAdded:Connect(onCharacterLoaded)
			if joinedPlayer.Character then
				task.spawn(onCharacterLoaded, joinedPlayer.Character)
			end
		end
