-- Tracks the base names of hats we have seen
-- Format: ["AccessoryName"] = highest_number_assigned
local hatTracker = {}

-- Function to check what hats already exist in the character
local function scanCurrentHats()
    for _, child in ipairs(Character:GetChildren()) do
        if child:IsA("Accessory") then
            local name = child.Name
            
            -- Check if the hat already has a trailing number we or something else gave it
            local baseName, existingNum = name:match("^(.-)(%d+)$")
            
            if existingNum then
                local num = tonumber(existingNum)
                if not hatTracker[baseName] or num > hatTracker[baseName] then
                    hatTracker[baseName] = num
                end
            else
                -- It's a clean name. If it's not tracked yet, log it as 0 (the original)
                if not hatTracker[name] then
                    hatTracker[name] = 0
                end
            end
        end
    end
end

-- Function processed whenever a brand new item is added
local function handleNewChild(child)
    if not child:IsA("Accessory") then return end
    
    local name = child.Name
    local baseName, existingNum = name:match("^(.-)(%d+)$")
    
    -- If the incoming hat already has a number, just log it and ignore
    if existingNum then
        local num = tonumber(existingNum)
        if not hatTracker[baseName] or num > hatTracker[baseName] then
            hatTracker[baseName] = num
        end
        return
    end
    
    -- LOGIC FOR CLEAN DUPLICATES:
    if hatTracker[name] ~= nil then
        -- We have seen this clean name before! This is a duplicate.
        -- Increment the count (the first duplicate gets 1, next gets 2, etc.)
        hatTracker[name] = hatTracker[name] + 1
        
        local newName = name .. tostring(hatTracker[name])
        child.Name = newName
        print("[Dex] Duplicate detected! Renamed to: " .. newName)
    else
        -- First time seeing this hat entirely. Keep it original and register it.
        hatTracker[name] = 0
        print("[Dex] Registered original hat: " .. name)
    end
end

