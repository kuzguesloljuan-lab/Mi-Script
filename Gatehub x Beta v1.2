toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
toggleBtn.BorderSizePixel = 0
toggleBtn.Text = ""
toggleBtn.Parent = settingFrame

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggleBtn

local circle = Instance.new("Frame")
circle.Size = UDim2.new(0, 18, 0, 18)
circle.Position = UDim2.new(0, 2, 0.5, -9)
circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
circle.BorderSizePixel = 0
circle.Parent = toggleBtn

local circleCorner = Instance.new("UICorner")
circleCorner.CornerRadius = UDim.new(1, 0)
circleCorner.Parent = circle

local blurEfecto = Lighting:FindFirstChild("GateBlurEffect")
local blurActivado = false

toggleBtn.Activated:Connect(function()
	reproducirSonidoBoton()
	blurActivado = not blurActivado
	if blurActivado then
		TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = COLOR_NARANJA}):Play()
		TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -20, 0.5, -9)}):Play()
		if not blurEfecto then
			blurEfecto = Instance.new("BlurEffect")
			blurEfecto.Name = "GateBlurEffect"
			blurEfecto.Size = 15
			blurEfecto.Parent = Lighting
		end
	else
		TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 55)}):Play()
		TweenService:Create(circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -9)}):Play()
		if blurEfecto then
			blurEfecto:Destroy()
			blurEfecto = nil
		end
	end
end)

