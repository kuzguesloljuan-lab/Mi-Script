	sec.ScrollBarThickness = 3
	sec.Parent = container
	
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = sec
	
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 16)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = sec
	
	local headerContainer = Instance.new("Frame")
	headerContainer.Size = UDim2.new(1, 0, 0, 42)
	headerContainer.BackgroundTransparency = 1
	headerContainer.LayoutOrder = -1
	headerContainer.Parent = sec
	
	local headerTitle = Instance.new("TextLabel")
	headerTitle.Size = UDim2.new(1, nombre == "Home" and -28 or 0, 0, 20)
	headerTitle.Position = UDim2.new(0, nombre == "Home" and 28 or 0, 0, 0)
	headerTitle.BackgroundTransparency = 1
