toggleHubBtn.Font = Enum.Font.GothamBold
toggleHubBtn.TextSize = 11
toggleHubBtn.Active = true
toggleHubBtn.Draggable = false
toggleHubBtn.Parent = screenGui

local toggleHubCorner = Instance.new("UICorner")
toggleHubCorner.CornerRadius = UDim.new(0, 8)
toggleHubCorner.Parent = toggleHubBtn

local toggleHubStroke = Instance.new("UIStroke")
toggleHubStroke.Color = COLOR_NARANJA
toggleHubStroke.Thickness = 1.5
toggleHubStroke.Transparency = 0.3
toggleHubStroke.Parent = toggleHubBtn

local dragging, dragStart, startPos, moved = false, nil, nil, false

toggleHubBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		moved = false
		dragStart = input.Position
		startPos = toggleHubBtn.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		if delta.Magnitude > 6 then
			moved = true
		end
		toggleHubBtn.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end
end)

