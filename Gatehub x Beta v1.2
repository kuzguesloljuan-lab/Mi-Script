			TweenService:Create(toggleHubBtn, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 56, 0, 34)
			}):Play()
		end
	end)
	
	if hubVisible then
		mainFrame.Visible = true
		TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 480, 0, 300)}):Play()
