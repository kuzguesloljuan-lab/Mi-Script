	headerTitle.TextXAlignment = Enum.TextXAlignment.Left
	headerTitle.Parent = headerContainer
	
	if nombre == "Home" then
		local iconFrame = Instance.new("ImageLabel")
		iconFrame.Size = UDim2.new(0, 20, 0, 20)
		iconFrame.Position = UDim2.new(0, 0, 0, 0)
		iconFrame.BackgroundTransparency = 1
		iconFrame.Image = "rbxassetid://6023426915"
		iconFrame.ImageColor3 = Color3.fromRGB(255, 255, 255)
		iconFrame.Parent = headerContainer
	end
	
	local headerLine = Instance.new("Frame")
	headerLine.Size = UDim2.new(0, 0, 0, 1)
	headerLine.Position = UDim2.new(0.5, 0, 0, 30)
	headerLine.AnchorPoint = Vector2.new(0.5, 0)
	headerLine.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
	headerLine.BorderSizePixel = 0
	headerLine.Parent = headerContainer
	
	lineasSeccion[nombre] = headerLine
	secciones[nombre] = sec
	return sec
end

local function cambiarSeccion(nombre, boton)
	reproducirSonidoBoton()
	for _, sec in pairs(secciones) do
		sec.Visible = false
	end
	if secciones[nombre] then
		secciones[nombre].Visible = true
		local linea = lineasSeccion[nombre]
		if linea then
			linea.Size = UDim2.new(0, 0, 0, 1)
			TweenService:Create(linea, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, 1)
			}):Play()
		end
	end
	if botonActualSeleccionado then
		TweenService:Create(botonActualSeleccionado, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(21, 21, 27)}):Play()
	end
	botonActualSeleccionado = boton
	TweenService:Create(boton, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = COLOR_NARANJA}):Play()
end

