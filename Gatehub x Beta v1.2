local function crearSeccion(nombre)
	local sec = Instance.new("ScrollingFrame")
	sec.Name = nombre .. "Sec"
	sec.Size = UDim2.new(1, 0, 1, 0)
	sec.BackgroundTransparency = 1
	sec.BorderSizePixel = 0
