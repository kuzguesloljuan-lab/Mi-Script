local function reproducirSonidoBoton()
	task.spawn(function()
		pcall(function()
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://18441519088"
			sound.Volume = 0.6
			sound.Parent = Workspace
			sound:Play()
			sound.Ended:Connect(function()
				sound:Destroy()
			end)
			task.delay(3, function()
				if sound and sound.Parent then
					sound:Destroy()
				end
			end)
		end)
	end)
end

-- Sonido de bienvenida al cargar el Hub
